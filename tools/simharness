#!/usr/bin/env python3
"""Run the simharness CLI straight from a checkout, with no install step.

``pip install -e .`` also puts a ``simharness`` entry point on your PATH; this
script exists so ``./tools/simharness --demo`` works on a fresh clone.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from simharness.cli import main  # noqa: E402  (path setup must come first)

if __name__ == "__main__":
    raise SystemExit(main())
